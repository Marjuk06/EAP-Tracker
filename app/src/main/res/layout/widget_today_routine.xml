<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_routine_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header Row with Prev / Next Routine Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="EAP TRACKER"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Prev Day Button -->
        <TextView
            android:id="@+id/widget_btn_prev_day"
            android:layout_width="34dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:text="◀"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Date / Day Badge -->
        <TextView
            android:id="@+id/widget_routine_date"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_widget_tag"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Today"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Next Day Button -->
        <TextView
            android:id="@+id/widget_btn_next_day"
            android:layout_width="34dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:text="▶"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#334155"
        android:contentDescription="@null" />

    <!-- Class Subject & Topics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_routine_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class: Physics (P-01)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_routine_topics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Topics: Self Study &amp; Concept Practice"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_routine_exam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Exam: Daily Preparation Test"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_open_routine"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_accent_button"
            android:gravity="center"
            android:text="View Routine"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_open_app"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:text="Open App"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
